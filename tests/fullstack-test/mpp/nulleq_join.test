# Preparation.
mysql> drop table if exists test.nulleq_l;
mysql> drop table if exists test.nulleq_r;
mysql> drop table if exists test.nulleq_not_null_r;
mysql> drop table if exists test.nulleq_mixed_l;
mysql> drop table if exists test.nulleq_mixed_r;
mysql> drop table if exists test.nulleq_string_l;
mysql> drop table if exists test.nulleq_string_r;

mysql> create table test.nulleq_l (case_id int not null, row_id int not null, k1 int null, k2 int null, v int, s varchar(32) null);
mysql> create table test.nulleq_r (case_id int not null, row_id int not null, k1 int null, k2 int null, v int, s varchar(32) null);

# Cases 1-6, 8-15, and 18 use these nullable integer columns.
mysql> insert into test.nulleq_l values
   (1,101,NULL,1,10,'l101'),(1,102,1,1,20,'l102'),(1,103,2,1,30,'l103'),
