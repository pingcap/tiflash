mysql> create table test.nulleq_not_null_r (case_id int not null, row_id int not null, k int not null, v int);
mysql> insert into test.nulleq_not_null_r values (15,2601,1,10),(15,2602,3,30);

mysql> create table test.nulleq_mixed_l (case_id int not null, row_id int not null, k1 int null, k2 int null, v int);
mysql> create table test.nulleq_mixed_r (case_id int not null, row_id int not null, k1 int not null, k2 int null, v int);
mysql> insert into test.nulleq_mixed_l values (16,2801,1,NULL,10),(16,2802,1,2,20),(16,2803,NULL,2,30);
mysql> insert into test.nulleq_mixed_r values (16,2901,1,NULL,11),(16,2902,1,2,21),(16,2903,2,2,31);

mysql> create table test.nulleq_string_l (case_id int not null, row_id int not null, s varchar(32) null);
mysql> create table test.nulleq_string_r (case_id int not null, row_id int not null, s varchar(32) null);
mysql> insert into test.nulleq_string_l values (17,3201,NULL),(17,3202,''),(17,3203,'same');
mysql> insert into test.nulleq_string_r values (17,3301,NULL),(17,3302,''),(17,3303,'same'),(17,3304,'other');

mysql> alter table test.nulleq_l set tiflash replica 1;
mysql> alter table test.nulleq_r set tiflash replica 1;
mysql> alter table test.nulleq_not_null_r set tiflash replica 1;
mysql> alter table test.nulleq_mixed_l set tiflash replica 1;
mysql> alter table test.nulleq_mixed_r set tiflash replica 1;
mysql> alter table test.nulleq_string_l set tiflash replica 1;
mysql> alter table test.nulleq_string_r set tiflash replica 1;
mysql> analyze table test.nulleq_l;
mysql> analyze table test.nulleq_r;
mysql> analyze table test.nulleq_not_null_r;
mysql> analyze table test.nulleq_mixed_l;
mysql> analyze table test.nulleq_mixed_r;
mysql> analyze table test.nulleq_string_l;
mysql> analyze table test.nulleq_string_r;

func> wait_table test nulleq_l
func> wait_table test nulleq_r
func> wait_table test nulleq_not_null_r
func> wait_table test nulleq_mixed_l
func> wait_table test nulleq_mixed_r
func> wait_table test nulleq_string_l
func> wait_table test nulleq_string_r

# Confirm that a NullEQ join is planned as a TiFlash MPP HashJoin.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; desc format='brief' select l.row_id as l_id, r.row_id as r_id from (select row_id, k1 from test.nulleq_l where case_id=1) l join (select row_id, k1 from test.nulleq_r where case_id=1) r on l.k1 <=> r.k1;
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#REGEXP}.*HashJoin\s+\d+\.\d+\s+mpp\[tiflash\]\s+.*inner join.*
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}

# Case 1: INNER JOIN matches NULL/NULL and equal non-NULL keys only.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=1) l join (select row_id, k1 from test.nulleq_r where case_id=1) r on l.k1 <=> r.k1 order by l.row_id, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
|  101 | NULL |  201 | NULL |
|  102 |    1 |  202 |    1 |
+------+------+------+------+

# Case 2: NULL keys are not deduplicated; two NULL rows on each side produce four matches.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=2) l join (select row_id, k1 from test.nulleq_r where case_id=2) r on l.k1 <=> r.k1 order by l.row_id, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
|  401 | NULL |  501 | NULL |
|  401 | NULL |  502 | NULL |
|  402 | NULL |  501 | NULL |
|  402 | NULL |  502 | NULL |
|  403 |    1 |  503 |    1 |
+------+------+------+------+

# Case 3: Ordinary equality keeps the historical NULL != NULL behavior.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=3) l join (select row_id, k1 from test.nulleq_r where case_id=3) r on l.k1 = r.k1 order by l.row_id, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
|  602 |    1 |  702 |    1 |
+------+------+------+------+

# Case 4: LEFT OUTER JOIN preserves an unmatched probe-side row while matching NULL/NULL.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=4) l left join (select row_id, k1 from test.nulleq_r where case_id=4) r on l.k1 <=> r.k1 order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
|  801 | NULL |  901 | NULL |
|  802 |    1 | NULL | NULL |
+------+------+------+------+

# Case 5: RIGHT OUTER JOIN matches a build-side NULL and does not emit it again as unmatched.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=5) l right join (select row_id, k1 from test.nulleq_r where case_id=5) r on l.k1 <=> r.k1 order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 1001 |    1 | 1102 |    1 |
| NULL | NULL | 1101 | NULL |
+------+------+------+------+

# Case 6: FULL OUTER JOIN covers NULL/NULL, one-to-many matches, and unmatched rows.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1 from test.nulleq_l where case_id=6) l full outer join (select row_id, k1 from test.nulleq_r where case_id=6) r on l.k1 <=> r.k1 order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 1201 | NULL | 1301 | NULL |
| 1202 |    1 | 1302 |    1 |
| 1202 |    1 | 1303 |    1 |
| 1203 |    1 | 1302 |    1 |
| 1203 |    1 | 1303 |    1 |
| 1204 |    4 | NULL | NULL |
| NULL | NULL | 1304 |    2 |
+------+------+------+------+

# Case 8: FULL OUTER JOIN marks only rows passing the other condition as matched.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1, v from test.nulleq_l where case_id=8) l full outer join (select row_id, k1, v from test.nulleq_r where case_id=8) r on l.k1 <=> r.k1 and l.v < r.v order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 1401 | NULL | 1501 | NULL |
| 1402 |    1 | 1503 |    1 |
| NULL | NULL | 1502 |    1 |
+------+------+------+------+

# Case 9: A NULL/NULL hash match failing the other condition produces two unmatched rows.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1, v from test.nulleq_l where case_id=9) l full outer join (select row_id, k1, v from test.nulleq_r where case_id=9) r on l.k1 <=> r.k1 and l.v < r.v order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 1601 | NULL | NULL | NULL |
| NULL | NULL | 1701 | NULL |
+------+------+------+------+

# Case 10: A failed left condition preserves both sides as unmatched.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1, v from test.nulleq_l where case_id=10) l full outer join (select row_id, k1, v from test.nulleq_r where case_id=10) r on l.k1 <=> r.k1 and l.v > 10 order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 1801 |    1 | NULL | NULL |
| NULL | NULL | 1901 |    1 |
+------+------+------+------+

# Case 11: A failed right condition preserves the build row as unmatched.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; set tidb_enable_full_outer_join=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k1 as r_k1 from (select row_id, k1, v from test.nulleq_l where case_id=11) l full outer join (select row_id, k1, v from test.nulleq_r where case_id=11) r on l.k1 <=> r.k1 and r.v > 10 order by l.row_id is null, l.row_id, r.row_id is null, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k1 |
+------+------+------+------+
| 2001 |    1 | NULL | NULL |
| NULL | NULL | 2101 |    1 |
+------+------+------+------+

# Case 12: A NullEQ key and a regular equality key have independent NULL semantics.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, l.k2 as l_k2, r.row_id as r_id, r.k1 as r_k1, r.k2 as r_k2 from (select row_id, k1, k2 from test.nulleq_l where case_id=12) l join (select row_id, k1, k2 from test.nulleq_r where case_id=12) r on l.k1 <=> r.k1 and l.k2 = r.k2 order by l.row_id, r.row_id;
+------+------+------+------+------+------+
| l_id | l_k1 | l_k2 | r_id | r_k1 | r_k2 |
+------+------+------+------+------+------+
| 2202 | NULL |    1 | 2302 | NULL |    1 |
| 2204 |    1 |    1 | 2304 |    1 |    1 |
+------+------+------+------+------+------+

# Case 13: Two NullEQ keys apply NULL-safe equality independently at both positions.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, l.k2 as l_k2, r.row_id as r_id, r.k1 as r_k1, r.k2 as r_k2 from (select row_id, k1, k2 from test.nulleq_l where case_id=13) l join (select row_id, k1, k2 from test.nulleq_r where case_id=13) r on l.k1 <=> r.k1 and l.k2 <=> r.k2 order by l.row_id, r.row_id;
+------+------+------+------+------+------+
| l_id | l_k1 | l_k2 | r_id | r_k1 | r_k2 |
+------+------+------+------+------+------+
| 2401 | NULL | NULL | 2501 | NULL | NULL |
| 2402 | NULL |    1 | 2502 | NULL |    1 |
| 2403 |    1 | NULL | 2503 |    1 | NULL |
| 2404 |    1 |    1 | 2504 |    1 |    1 |
+------+------+------+------+------+------+

# Case 14: Reversing the mixed key flags does not make the first regular key null-safe.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, l.k2 as l_k2, r.row_id as r_id, r.k1 as r_k1, r.k2 as r_k2 from (select row_id, k1, k2 from test.nulleq_l where case_id=13) l join (select row_id, k1, k2 from test.nulleq_r where case_id=13) r on l.k1 = r.k1 and l.k2 <=> r.k2 order by l.row_id, r.row_id;
+------+------+------+------+------+------+
| l_id | l_k1 | l_k2 | r_id | r_k1 | r_k2 |
+------+------+------+------+------+------+
| 2403 |    1 | NULL | 2503 |    1 | NULL |
| 2404 |    1 |    1 | 2504 |    1 |    1 |
+------+------+------+------+------+------+

# Case 15: Nullable(T) <=> NOT NULL T is equivalent to ordinary equality.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, r.row_id as r_id, r.k as r_k from (select row_id, k1 from test.nulleq_l where case_id=15) l join (select row_id, k from test.nulleq_not_null_r where case_id=15) r on l.k1 <=> r.k order by l.row_id, r.row_id;
+------+------+------+------+
| l_id | l_k1 | r_id | r_k |
+------+------+------+------+
| 2702 |    1 | 2601 |    1 |
+------+------+------+------+

# Case 16: A nullable key and a not-null key can coexist with another NullEQ key.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.k1 as l_k1, l.k2 as l_k2, r.row_id as r_id, r.k1 as r_k1, r.k2 as r_k2 from test.nulleq_mixed_l l join test.nulleq_mixed_r r on l.k1 <=> r.k1 and l.k2 <=> r.k2 where l.case_id=16 and r.case_id=16 order by l.row_id, r.row_id;
+------+------+------+------+------+------+
| l_id | l_k1 | l_k2 | r_id | r_k1 | r_k2 |
+------+------+------+------+------+------+
| 2801 |    1 | NULL | 2901 |    1 | NULL |
| 2802 |    1 |    2 | 2902 |    1 |    2 |
+------+------+------+------+------+------+

# Case 17: Nullable String uses NULL-safe equality without confusing NULL and the empty string.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id as l_id, l.s as l_s, r.row_id as r_id, r.s as r_s from test.nulleq_string_l l join test.nulleq_string_r r on l.s <=> r.s where l.case_id=17 and r.case_id=17 order by l.row_id, r.row_id;
+------+------+------+
| l_id | l_s  | r_id | r_s  |
+------+------+------+
| 3201 | NULL | 3301 | NULL |
| 3202 |      | 3302 |      |
| 3203 | same | 3303 | same |
+------+------+------+

# Case 18: EXISTS and NOT EXISTS use NullEQ existence semantics.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id from test.nulleq_l l where l.case_id=18 and exists (select 1 from test.nulleq_r r where r.case_id=18 and l.k1 <=> r.k1) order by l.row_id;
+--------+
| row_id |
+--------+
|   3001 |
|   3002 |
+--------+
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.row_id from test.nulleq_l l where l.case_id=18 and not exists (select 1 from test.nulleq_r r where r.case_id=18 and l.k1 <=> r.k1) order by l.row_id;
+--------+
| row_id |
+--------+
|   3003 |
+--------+

# Clean up.
mysql> drop table if exists test.nulleq_l;
mysql> drop table if exists test.nulleq_r;
mysql> drop table if exists test.nulleq_not_null_r;
mysql> drop table if exists test.nulleq_mixed_l;
mysql> drop table if exists test.nulleq_mixed_r;
mysql> drop table if exists test.nulleq_string_l;
mysql> drop table if exists test.nulleq_string_r;
