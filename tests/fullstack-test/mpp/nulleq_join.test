   (12,2201,NULL,NULL,10,'l2201'),(12,2202,NULL,1,20,'l2202'),(12,2203,1,NULL,30,'l2203'),(12,2204,1,1,40,'l2204'),
   (13,2401,NULL,NULL,10,'l2401'),(13,2402,NULL,1,20,'l2402'),(13,2403,1,NULL,30,'l2403'),(13,2404,1,1,40,'l2404'),
   (18,3001,NULL,1,10,'l3001'),(18,3002,1,1,20,'l3002'),(18,3003,2,1,30,'l3003');

