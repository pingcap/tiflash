mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_enable_full_outer_join=1; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.id as l_id, l.c as l_c, r.id as r_id, r.c as r_c from (select id, c from test.foj_l where case_id=25) l full outer join (select id, c from test.foj_r where case_id=25) r on l.id = r.id and l.c < r.c order by l.id is null, l.id, l.c is null, l.c, r.id is null, r.id, r.c is null, r.c;
+------+------+------+------+
| l_id | l_c  | r_id | r_c  |
+------+------+------+------+
|    1 |    9 | NULL | NULL |
|    2 |    3 |    2 |    4 |
|    3 |    3 |    3 |    5 |
| NULL | NULL |    1 |    4 |
| NULL | NULL |    1 |    5 |
| NULL | NULL |    3 |    2 |
| NULL | NULL |    4 |    8 |
+------+------+------+------+

# Case 26: FOJ_WithOther_LeftAndRightCondition_Mixed
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_enable_full_outer_join=1; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.id as l_id, l.c as l_c, r.id as r_id, r.c as r_c from (select id, c from test.foj_l where case_id=26) l full outer join (select id, c from test.foj_r where case_id=26) r on l.id = r.id and l.c > 10 and r.c > 100 and l.c < r.c order by l.id is null, l.id, l.c is null, l.c, r.id is null, r.id, r.c is null, r.c;
+------+------+------+------+
| l_id | l_c  | r_id | r_c  |
+------+------+------+------+
|    1 |    5 | NULL | NULL |
|    2 |   20 | NULL | NULL |
| NULL | NULL |    1 |  200 |
| NULL | NULL |    2 |   10 |
| NULL | NULL |    3 |   50 |
