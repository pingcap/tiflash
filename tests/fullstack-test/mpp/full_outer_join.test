# Preparation.
mysql> drop table if exists test.foj_l;
mysql> drop table if exists test.foj_r;
mysql> create table test.foj_l (case_id int not null, id int, c int);
mysql> create table test.foj_r (case_id int not null, id int, c int);

mysql> insert into test.foj_l values (1,1,10),(2,1,10),(3,1,10),(4,1,5),(5,1,10),(6,NULL,10),(7,1,10),(8,1,5),(8,2,20);
mysql> insert into test.foj_l values (9,1,10),(9,1,11),(10,NULL,10),(11,1,10),(11,2,20),(11,3,30),(12,1,10),(13,1,3),(14,1,7);
mysql> insert into test.foj_l values (15,1,9),(16,1,3),(17,1,3),(18,1,3),(19,1,5),(20,1,10),(21,NULL,10),(22,1,10),(23,NULL,10);
mysql> insert into test.foj_l values (24,1,3),(24,1,4),(25,1,9),(25,2,3),(25,3,3),(26,1,5),(26,2,20);

mysql> insert into test.foj_r values (1,2,20),(2,1,20),(3,1,20),(3,1,30),(4,1,20),(5,1,5),(6,1,20),(7,NULL,20),(8,1,200),(8,3,50);
mysql> insert into test.foj_r values (9,1,20),(10,NULL,20),(11,2,200),(11,3,300),(11,3,301),(11,4,400),(12,2,20),(13,1,5),(14,1,5);
mysql> insert into test.foj_r values (15,1,3),(15,1,4),(16,1,2),(16,1,4),(16,1,1),(17,1,4),(17,1,5),(18,1,2),(18,1,4),(18,1,5);
mysql> insert into test.foj_r values (19,1,20),(20,1,5),(21,1,20),(22,NULL,20),(23,NULL,20),(24,1,5),(25,1,4),(25,1,5),(25,2,4);
mysql> insert into test.foj_r values (25,3,2),(25,3,5),(25,4,8),(26,1,200),(26,2,10),(26,3,50);

mysql> alter table test.foj_l set tiflash replica 1;
mysql> alter table test.foj_r set tiflash replica 1;
mysql> analyze table test.foj_l;
mysql> analyze table test.foj_r;

func> wait_table test foj_l
func> wait_table test foj_r

# Check full outer join is pushed down to TiFlash MPP as a hash join.
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_enable_full_outer_join=1; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; desc format='brief' select l.id as l_id, r.id as r_id from (select id from test.foj_l where case_id=1) l full outer join (select id from test.foj_r where case_id=1) r on l.id = r.id;
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#REGEXP}.*HashJoin\s+\d+\.\d+\s+mpp\[tiflash\]\s+.*full outer join.*
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}
{#LINE}

# Case 1: FOJ_NoOther_BasicMiss_NotNullKey
mysql> set @@tidb_isolation_read_engines='tiflash'; set tidb_enable_full_outer_join=1; set tidb_allow_mpp=1; set tidb_enforce_mpp=1; select l.id as l_id, l.c as l_c, r.id as r_id, r.c as r_c from (select id, c from test.foj_l where case_id=1) l full outer join (select id, c from test.foj_r where case_id=1) r on l.id = r.id order by l.id is null, l.id, l.c is null, l.c, r.id is null, r.id, r.c is null, r.c;
+------+------+------+------+
| l_id | l_c  | r_id | r_c  |
+------+------+------+------+
|    1 |   10 | NULL | NULL |
| NULL | NULL |    2 |   20 |
+------+------+------+------+

